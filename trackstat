            snapshot.Sea = number
        end
        for field, value in pairs(inventorySnapshot()) do snapshot[field] = value end
        if settings.Config.Device then snapshot.Device = device() end
        if settings.Config.Executor then snapshot.Executor = executor() end
        return snapshot
    end

    local function heartbeat(status, errorCode)
        phase = "heartbeat"
        local payload = {
            schemaVersion = 1, collectorVersion = VERSION, Game = GAME_KEY, GameTitle = GAME_TITLE, PlaceId = game.PlaceId, sessionId = sessionId,
            Name = settings.Name, UserId = integer(player.UserId, "UserId"), Username = textValue(player.Name, "Username"),
            observedAt = os.time(), intervalSeconds = INTERVAL, collectorStatus = status or "ok",
        }
        if errorCode then payload.collectorError = textValue(errorCode, "collectorError", 64) end
        if settings.Config.Device then payload.Device = device() end
        if settings.Config.Executor then payload.Executor = executor() end
