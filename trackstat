        for _, field in ipairs(INVENTORIES) do counts[field] = 0 end
        for _, config in ipairs(array(catalog.dumpItems(), "ItemConfig.dumpItems")) do
            local field = category(config)
            if field and settings.Config[field] then
                local id = integer(config.Index.ItemId, "ItemId")
                if not catalogById[id] then
                    catalogById[id] = {Config = config, Field = field}
                    counts[field] = counts[field] + 1
                    if config.Index.IdType ~= "Accessory" then refreshIds[#refreshIds + 1] = id end
                end
            end
        end
        table.sort(refreshIds)
        if #refreshIds > 1000 then fail("CATALOG_LIMIT", "Refresh would exceed budget") end
        for _, field in ipairs(INVENTORIES) do
            if settings.Config[field] then
                log("CATALOG", field .. " candidates=" .. counts[field])
                if counts[field] == 0 then fail("CATALOG_EMPTY", field) end
            end
        end
        for _, key in ipairs({"QUANTITY", "IS_OWNED", "ACCESSORY_TYPE"}) do
            if type(keys[key]) ~= "string" then fail("MODULE_SHAPE", "KEYS." .. key) end
        end
    end

    local function inventorySnapshot()
