        if type(config.Index) ~= "table" then fail("CATALOG_SHAPE", "Missing Index") end
        if config.Index.IdType == "Moveset" and config.Moveset and config.Moveset.Type == "FightingStyle" then return "Melee" end
        local brackets = config.Inventory and config.Inventory.Brackets
