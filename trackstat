    local function bounded(name, seconds, fn)
        checkRunning()
        if pending[name] then fail("CALL_PENDING", name) end
        local job = {Done = false}
        pending[name] = job
        local started = os.clock()
        local thread = task.spawn(function()
            job.Ok, job.Value = xpcall(fn, capture)
            job.Done = true
            if pending[name] == job then pending[name] = nil end
        end)
        while not job.Done do
            if not Tracker.Running then
                if pending[name] == job then pending[name] = nil end
                if thread and task.cancel then pcall(task.cancel, thread) end
                fail("STOPPED")
            end
            if os.clock() - started >= seconds then
                if pending[name] == job then pending[name] = nil end
                if thread and task.cancel then pcall(task.cancel, thread) end
                fail("CALL_TIMEOUT", name)
            end
            task.wait(0.05)
        end
        checkRunning()
        log("CALL", name .. " " .. math.floor((os.clock() - started) * 1000) .. "ms")
        if not job.Ok then error(job.Value, 0) end
        return job.Value
    end

    local function waitFor(name, fn)
        local deadline = os.clock() + LOAD_TIMEOUT
        repeat
            checkRunning()
            local result = fn()
            if result then return result end
            task.wait(0.25)
        until os.clock() >= deadline
        fail("DATA_NOT_READY", name)
    end

    local function moduleAt(path)
        if modules[path] then return modules[path] end
        local instance = ReplicatedStorage
        for part in path:gmatch("[^/]+") do
            instance = instance:FindFirstChild(part)
            if not instance then fail("MODULE_MISSING", path) end
        end
        local value = bounded("require:" .. path, TIMEOUT, function() return require(instance) end)
        if type(value) ~= "table" then fail("MODULE_SHAPE", path) end
        modules[path] = value
        return value
    end

    local function integer(value, name)
        if type(value) ~= "number" or value ~= value or value < 0 or value > 9007199254740991 or value % 1 ~= 0 then
            fail("INVALID_NUMBER", name)
        end
        return value
    end

    local function textValue(value, name, limit)
        if type(value) ~= "string" or #value == 0 or #value > (limit or 256) or value:find("[%c]") then
            fail("INVALID_TEXT", name)
        end
        return value
    end

    local function array(value, name)
        if type(value) ~= "table" then fail("INVALID_ARRAY", name) end
        local count = 0
        for key in pairs(value) do
            count = count + 1
            if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then fail("INVALID_ARRAY", name) end
        end
        if count ~= #value or count > MAX_ROWS then fail("INVALID_ARRAY", name) end
        return value
    end

    local function has(list, value)
