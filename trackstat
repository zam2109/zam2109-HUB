        if #refreshIds > 0 then
            local response = array(remote("ItemReplicationServiceRefreshAsync", refreshIds, nil, {keys.QUANTITY, keys.IS_OWNED}), "RefreshAsync")
            if #response ~= #refreshIds then fail("INVENTORY_INCOMPLETE", "Refresh response count mismatch") end
            local received = {}
            for _, row in ipairs(response) do
                if type(row) ~= "table" or not catalogById[row.ItemId] or row.UID ~= nil or type(row.Attributes) ~= "table" or received[row.ItemId] then
                    fail("INVENTORY_SHAPE", "Invalid refresh row")
                end
                received[row.ItemId] = true
                records[tostring(row.ItemId)] = {ItemId = row.ItemId, Values = row.Attributes}
            end
            for _, id in ipairs(refreshIds) do if not received[id] then fail("INVENTORY_INCOMPLETE", "Missing refreshed ItemId") end end
        end
        if settings.Config.Accessories then
            local rows = array(remote("GetAllItemValues"), "GetAllItemValues")
            for _, row in ipairs(rows) do
                if type(row) ~= "table" or type(row.ItemId) ~= "number" or type(row.Key) ~= "string" then fail("INVENTORY_SHAPE", "Invalid replication row") end
                local entry = catalogById[row.ItemId]
                if not entry and row.NetworkedUID and row.Key == keys.ACCESSORY_TYPE and row.Value == "Super" then
                    fail("CATALOG_MISSING", "Dynamic accessory ItemId " .. tostring(row.ItemId))
                end
                if entry and entry.Field == "Accessories" and entry.Config.Index.IdType == "Accessory" then
                    local uid = textValue(row.NetworkedUID, "NetworkedUID", 256)
                    local recordKey = tostring(row.ItemId) .. ":" .. uid
                    records[recordKey] = records[recordKey] or {ItemId = row.ItemId, NetworkedUID = uid, Values = {}}
                    if row.Key == keys.QUANTITY or row.Key == keys.IS_OWNED or row.Key == keys.ACCESSORY_TYPE then
                        records[recordKey].Values[row.Key] = row.Value
                    end
                end
            end
        end
        for _, record in pairs(records) do
            local entry = catalogById[record.ItemId]
            local values = record.Values
            local quantity, owned = values[keys.QUANTITY], values[keys.IS_OWNED]
            if quantity ~= nil then integer(quantity, "Quantity") end
            if owned ~= nil and type(owned) ~= "boolean" then fail("INVENTORY_SHAPE", "IsOwned must be boolean") end
            local dynamic = entry.Config.Index.IdType == "Accessory"
            if dynamic then
                local accessoryType = values[keys.ACCESSORY_TYPE]
                if accessoryType ~= nil and accessoryType ~= "Super" then fail("INVENTORY_SHAPE", "Unexpected accessory type in Accessories bracket") end
                if accessoryType == "Super" then quantity = 1 end
            elseif quantity == nil and owned == true and entry.Field ~= "FruitInventory" then
                quantity = 1
            end
            if entry.Field == "FruitInventory" and owned == true and quantity == nil then fail("INVENTORY_INCOMPLETE", "Fruit quantity missing") end
            if quantity and quantity > 0 then
                local config = entry.Config
                local storageKey = textValue(config.Index.StorageKey, "StorageKey")
                local name = config.Display and config.Display.Name
                if type(name) ~= "string" or #name == 0 then name = storageKey end
                local item = {ItemId = record.ItemId, Name = textValue(name, "Item.Name"), StorageKey = storageKey, Quantity = quantity}
                if record.NetworkedUID then item.NetworkedUID = record.NetworkedUID end
                local group = selected[entry.Field]
                group.Items[#group.Items + 1] = item
                group.Count = group.Count + 1
            end
        end
        for field, group in pairs(selected) do
            table.sort(group.Items, function(a, b)
                if a.ItemId == b.ItemId then return (a.NetworkedUID or "") < (b.NetworkedUID or "") end
                return a.ItemId < b.ItemId
            end)
            if field == "Melee" and group.Count == 0 then fail("INVENTORY_INCOMPLETE", "No owned fighting style; verify ownership replication") end
            log("COLLECT_OK", field .. " rows=" .. group.Count)
        end
        return selected
    end

    local function stat(parent, name)
        local value = parent and parent:FindFirstChild(name)
        if not value or not (value:IsA("IntValue") or value:IsA("NumberValue")) then fail("STAT_MISSING", name) end
        return integer(value.Value, name)
    end

    local function device()
        local ok, result = pcall(function()
            local platform = game:GetService("UserInputService"):GetPlatform().Name
            if platform == "Windows" or platform == "OSX" or platform == "Linux" or platform == "UWP" then return "PC" end
            if platform == "IOS" or platform == "Android" then return "Mobile" end
            if platform == "XBoxOne" or platform == "PS4" or platform == "PS5" then return "Console" end
            return "Unknown"
        end)
        if ok and result ~= "Unknown" then return result end
        log("DEVICE_FALLBACK", "Platform unavailable; trying game input classification")
        local fallbackOk, input = xpcall(function() return moduleAt("Modules/LastInput"):Get() end, capture)
        if fallbackOk then return ({MouseKeyboard = "PC", Touch = "Mobile", Gamepad = "Console"})[input] or "Unknown" end
        return "Unknown"
    end

    local function executor()
        for _, name in ipairs({"identifyexecutor", "getexecutorname"}) do
            local fn = env[name]
            if type(fn) == "function" then
                local ok, result = pcall(fn)
                if ok and type(result) == "string" and #result > 0 then return clean(result):sub(1, 128) end
            end
        end
        return "Unknown"
    end

    local function collect()
        if not player:FindFirstChild("DataLoaded") then fail("DATA_NOT_READY", "DataLoaded") end
        local data = player:FindFirstChild("Data")
        if not data then fail("DATA_NOT_READY", "Data") end
        local snapshot = {}
        for _, field in ipairs({"Level", "Beli", "Fragments"}) do
            if settings.Config[field] then
                snapshot[field] = stat(data, field)
                log("COLLECT_OK", field)
            end
        end
