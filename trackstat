        if has(groups, "Backpack") and has(brackets, "Guns") then return "Guns" end
        if has(brackets, "Fruits") and config.Index.IdType == "PhysicalMoveset" then return "FruitInventory" end
        if has(brackets, "Accessories") and config.Index.IdType == "Accessory" then return "Accessories" end
        return nil
    end

    local catalog, catalogById, refreshIds, keys
    local function prepareInventory()
