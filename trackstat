        local snapshot = collect()
        checkRunning()
        sequence = sequence + 1
        local payload = {
            schemaVersion = 1, collectorVersion = VERSION, Game = GAME_KEY, GameTitle = GAME_TITLE, PlaceId = game.PlaceId, sessionId = sessionId, sequence = sequence,
            Name = settings.Name, UserId = integer(player.UserId, "UserId"), Username = textValue(player.Name, "Username"),
            observedAt = os.time(), collectionDurationMs = math.floor((os.clock() - started) * 1000), intervalSeconds = INTERVAL,
            Config = settings.Config, Snapshot = snapshot,
