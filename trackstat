        if type(response.Body) ~= "string" or #response.Body > MAX_BYTES then fail("API_PROTOCOL", "Invalid response body") end
        local decodedOk, body = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if not decodedOk or type(body) ~= "table" or body.ok ~= true then fail("API_PROTOCOL", "Expected JSON ok=true") end
        if path == "/v1/tracker/snapshots" and (body.sessionId ~= sessionId or body.sequence ~= sequence) then
            fail("API_PROTOCOL", "Snapshot acknowledgement mismatch")
        end
        if path == "/v1/tracker/heartbeat" and body.sessionId ~= sessionId then
            fail("API_PROTOCOL", "Heartbeat acknowledgement mismatch")
        end
        return body
    end

    local function shapeOf(value, depth)
        local valueType = typeof(value)
        if valueType ~= "table" then return valueType end
        if depth <= 0 then return "table" end
        local result, count = {}, 0
        for key, child in pairs(value) do
            count = count + 1
            if count > 100 then
                result.__truncated = true
                break
            end
            result[tostring(key)] = shapeOf(child, depth - 1)
        end
        return result
    end

    local function device()
        local ok, result = pcall(function()
            local platform = UserInputService:GetPlatform().Name
            if platform == "Windows" or platform == "OSX" or platform == "Linux" or platform == "UWP" then return "PC" end
            if platform == "IOS" or platform == "Android" then return "Mobile" end
            if platform == "XBoxOne" or platform == "PS4" or platform == "PS5" then return "Console" end
            return "Unknown"
        end)
        if ok then return result end
        return "Unknown"
    end

    local function executor()
        for _, name in ipairs({"identifyexecutor", "getexecutorname"}) do
            local fn = rawget(env, name)
            if type(fn) == "function" then
                local ok, result = pcall(fn)
                if ok and type(result) == "string" and #result > 0 then return clean(result):sub(1, 128) end
            end
        end
        return "Unknown"
    end

    local function makeGroup(map)
        local keys = {}
        for key in pairs(map) do keys[#keys + 1] = key end
        table.sort(keys)
        local items, total = {}, 0
        for _, key in ipairs(keys) do
            local row = map[key]
            items[#items + 1] = row
            total = total + row.Quantity
        end
        return {Count = #items, TotalQuantity = total, Items = items}
    end

    local function quantityFrom(value)
        if type(value) == "number" then
            if value ~= value or value <= 0 then return 0 end
            return math.floor(value)
        end
        if type(value) == "table" then
            local quantity = value.Quantity or value.Count or value.Amount or value.Owned
            if type(quantity) == "number" and quantity == quantity and quantity > 0 then return math.floor(quantity) end
            return 1
        end
        if value == true then return 1 end
        return 0
    end

    local function displayName(key, value)
        if type(value) == "table" then
            local candidate = value.DisplayName or value.ItemName or value.Name or value.Id or value.Type
            if type(candidate) == "string" and #candidate > 0 then return candidate end
        end
        if type(key) == "string" and #key > 0 then return key end
        return tostring(key)
    end

    local function categoryGroup(category)
        if type(category) ~= "table" then fail("DATA_NOT_READY", "Inventory category") end
        local map, rows = {}, 0
        for key, value in pairs(category) do
            rows = rows + 1
            if rows > MAX_ROWS then fail("INVENTORY_LIMIT", "category") end
            local quantity = quantityFrom(value)
            if quantity > 0 then
                local name = displayName(key, value)
                local current = map[name]
                if current then current.Quantity = current.Quantity + quantity else map[name] = {Name = textValue(name, "Inventory.Name"), Quantity = quantity} end
            end
        end
        return makeGroup(map)
    end

    local function itemsGroup(inventory)
        local map, rows = {}, 0
        if type(inventory) ~= "table" then fail("DATA_NOT_READY", "Inventory") end
        for categoryName, category in pairs(inventory) do
            if categoryName ~= "Pets" and categoryName ~= "Seeds" and type(category) == "table" then
                for key, value in pairs(category) do
                    rows = rows + 1
                    if rows > MAX_ROWS then fail("INVENTORY_LIMIT", "Inventory") end
                    local quantity = quantityFrom(value)
                    if quantity > 0 then
                        local name = displayName(key, value)
                        local mapKey = tostring(categoryName) .. "\0" .. name
                        local current = map[mapKey]
                        if current then
                            current.Quantity = current.Quantity + quantity
                        else
                            map[mapKey] = {Category = textValue(tostring(categoryName), "Inventory.Category"), Name = textValue(name, "Inventory.Name"), Quantity = quantity}
                        end
                    end
                end
            end
        end
        return makeGroup(map)
    end

    local function getReplica()
        if localReplica and localReplica.Data then return localReplica end
        localReplica = bounded("WaitForLocalReplica", 35, function() return PlayerStateClient:WaitForLocalReplica(30) end)
        if type(localReplica) ~= "table" or type(localReplica.Data) ~= "table" then fail("DATA_NOT_READY", "PlayerState replica") end
        return localReplica
    end

    local function collect()
        local replica = getReplica()
        local data = replica.Data
        latestShape = debugEnabled and shapeOf(data, 3) or latestShape
        local snapshot = {}
        if settings.Config.Sheckles then snapshot.Sheckles = integer(data.Sheckles, "Sheckles") end
        if settings.Config.Tokens then snapshot.Tokens = integer(data.Tokens, "Tokens") end
        local inventory = data.Inventory
        if (settings.Config.Pets or settings.Config.Seeds or settings.Config.Items) and type(inventory) ~= "table" then fail("DATA_NOT_READY", "Inventory") end
        if settings.Config.Pets then snapshot.Pets = categoryGroup(inventory.Pets) end
        if settings.Config.Seeds then snapshot.Seeds = categoryGroup(inventory.Seeds) end
        if settings.Config.Items then snapshot.Items = itemsGroup(inventory) end
        if settings.Config.OwnedExpansions then snapshot.OwnedExpansions = integer(data.OwnedExpansions, "OwnedExpansions") end
        if settings.Config.Device then snapshot.Device = device() end
        if settings.Config.Executor then snapshot.Executor = executor() end
        latestPreview = snapshot
        log("COLLECT_OK", "snapshot ready")
        return snapshot
    end

    function Tracker.CollectNow()
        return collect()
    end

    local function basePayload()
        return {
            schemaVersion = 1,
            collectorVersion = VERSION,
            Game = GAME_KEY,
            GameTitle = GAME_TITLE,
            PlaceId = game.PlaceId,
            sessionId = sessionId,
            Name = settings.Name,
            UserId = integer(player.UserId, "UserId"),
            Username = textValue(player.Name, "Username"),
            observedAt = os.time(),
            intervalSeconds = INTERVAL,
        }
    end

    local function heartbeat(status, errorCode)
        phase = "heartbeat"
        local payload = basePayload()
        payload.collectorStatus = status or "ok"
        if errorCode then payload.collectorError = textValue(errorCode, "collectorError", 64) end
        if settings.Config.Device then payload.Device = device() end
        if settings.Config.Executor then payload.Executor = executor() end
        api("/v1/tracker/heartbeat", payload)
        lastHeartbeat = os.time()
        log("HEARTBEAT_OK", payload.collectorStatus)
        phase = "waiting"
    end

    local function syncSnapshot()
        phase = "collecting"
        local started = os.clock()
        local snapshot = collect()
        checkRunning()
        sequence = sequence + 1
        local payload = basePayload()
        payload.sequence = sequence
        payload.collectionDurationMs = math.floor((os.clock() - started) * 1000)
        payload.Config = settings.Config
        payload.Snapshot = snapshot
        phase = "uploading"
        api("/v1/tracker/snapshots", payload)
        lastSuccess = os.time()
        lastHeartbeat = lastSuccess
        lastError = nil
        log("SYNC_OK", "sequence=" .. sequence)
        phase = "waiting"
    end

    local function terminalApiError(code)
        return code == "INVALID_KEY" or code == "SESSION_EXPIRED" or code == "API_REJECTED"
    end

    local function apiError(code)
        return code == "INVALID_KEY" or code == "SESSION_EXPIRED" or code == "API_REJECTED" or code == "API_SERVER" or code == "API_PROTOCOL" or code == "HTTP_UNAVAILABLE" or code == "API_NOT_CONFIGURED"
    end

    local function runHeartbeatAfterCollectionError(err)
        local ok, heartbeatErr = xpcall(function() heartbeat("error", err.Code) end, capture)
        if not ok then
            if heartbeatErr.Code == "STOPPED" then return false, heartbeatErr end
            log(heartbeatErr.Code, heartbeatErr.Detail)
            if terminalApiError(heartbeatErr.Code) then return false, heartbeatErr end
        end
        return true, heartbeatErr
    end

    local function initialSnapshot()
        local deadline = os.clock() + INITIAL_COLLECT_TIMEOUT
        local lastErr
        repeat
            checkRunning()
            local ok, err = xpcall(syncSnapshot, capture)
            if ok then return true end
            if err.Code == "STOPPED" then error(err, 0) end
            lastErr = err
            lastError = err.Code
            log(err.Code, err.Detail)
            if apiError(err.Code) then return false, err end
            if os.clock() >= deadline then break end
            task.wait(INITIAL_RETRY_DELAY)
        until os.clock() >= deadline
        return false, lastErr or {Code = "DATA_NOT_READY", Detail = "Initial collection timed out"}
    end

    local function runCycle()
        local ok, err = xpcall(syncSnapshot, capture)
        if ok then return true end
        if err.Code == "STOPPED" then return false, err end
        lastError = err.Code
        log(err.Code, err.Detail)
        if terminalApiError(err.Code) then return false, err end
        if not apiError(err.Code) then
            local heartbeatOk, heartbeatErr = runHeartbeatAfterCollectionError(err)
            if not heartbeatOk then return false, heartbeatErr end
        end
        phase = "waiting"
        return true, err
    end

    local function run()
        validate()
        phase = "loading"
        waitFor("game loaded", function() return game:IsLoaded() end)
        player = waitFor("LocalPlayer", function() return Players.LocalPlayer end)
        integer(player.UserId, "UserId")
        local clientModules = ReplicatedStorage:FindFirstChild("ClientModules")
        if not clientModules or not clientModules:FindFirstChild("PlayerStateClient") then fail("WRONG_GAME", "Grow a Garden 2 PlayerStateClient not found") end
        PlayerStateClient = moduleAt("ClientModules/PlayerStateClient")
        localReplica = getReplica()
        sessionId = HttpService:GenerateGUID(false)
        if not apiConfigured() then
            if debugEnabled then
                local ok, err = xpcall(collect, capture)
                if not ok then
                    lastError = err.Code
                    log(err.Code, err.Detail)
                end
            end
            fail("API_NOT_CONFIGURED")
        end
        phase = "authenticating"
        api("/v1/tracker/validate", {schemaVersion = 1, collectorVersion = VERSION, Game = GAME_KEY, PlaceId = game.PlaceId, sessionId = sessionId, Name = settings.Name, UserId = player.UserId})
        local initialOk, initialErr = initialSnapshot()
        if initialOk then
            notifyOnce("Data synced successfully.")
        else
            if not apiError(initialErr.Code) then
                local heartbeatOk, heartbeatErr = runHeartbeatAfterCollectionError(initialErr)
                if not heartbeatOk and heartbeatErr and apiError(heartbeatErr.Code) then initialErr = heartbeatErr end
            end
            notifyOnce(messageFor(initialErr.Code))
            if terminalApiError(initialErr.Code) then Tracker.Stop() return end
        end
        local firstDelay = INTERVAL + ((player.UserId % (STAGGER_MAX_MS + 1)) / 1000)
        log("STAGGER", tostring(math.floor((firstDelay - INTERVAL) * 1000)) .. "ms")
        local delay = firstDelay
        while Tracker.Running do
            local nextAt = os.clock() + delay
            delay = INTERVAL
            while Tracker.Running and os.clock() < nextAt do task.wait(math.min(0.5, nextAt - os.clock())) end
            if not Tracker.Running then break end
            local continueRunning, err = runCycle()
            if not continueRunning then
                if err and err.Code ~= "STOPPED" then lastError = err.Code end
                Tracker.Stop()
                break
            end
            if err and err.Code == "API_SERVER" then delay = INTERVAL * 2 end
        end
    end

    task.spawn(function()
        local ok, err = xpcall(run, capture)
        if not ok and err.Code ~= "STOPPED" then
            lastError = err.Code
            log(err.Code, err.Detail)
            notifyOnce(messageFor(err.Code))
        end
        Tracker.Running = false
        phase = "stopped"
    end)

    return Tracker
    end,
}


