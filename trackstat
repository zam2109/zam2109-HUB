        api("/v1/tracker/snapshots", payload)
        lastSuccess = os.time()
        lastHeartbeat = lastSuccess
        lastError = nil
        log("SYNC_OK", "sequence=" .. sequence)
        phase = "waiting"
    end

    local function terminalApiError(code)
        return code == "INVALID_KEY" or code == "SESSION_EXPIRED" or code == "API_REJECTED"
    end

    local function apiError(code)
        return code == "INVALID_KEY" or code == "SESSION_EXPIRED" or code == "API_REJECTED" or code == "API_SERVER" or code == "API_PROTOCOL" or code == "HTTP_UNAVAILABLE" or code == "API_NOT_CONFIGURED"
    end

    local function runHeartbeatAfterCollectionError(err)
        local ok, heartbeatErr = xpcall(function() heartbeat("error", err.Code) end, capture)
        if not ok then
            if heartbeatErr.Code == "STOPPED" then return false, heartbeatErr end
            log(heartbeatErr.Code, heartbeatErr.Detail)
            if terminalApiError(heartbeatErr.Code) then return false, heartbeatErr end
        end
        return true, heartbeatErr
    end

    local function initialSnapshot()
