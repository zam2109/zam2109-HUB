    local function validate()
        local raw = env.Zam2109_Settings
        if type(raw) ~= "table" then fail("INVALID_SETTINGS", "Zam2109_Settings must be a table") end
        apiKey = raw.key
        if type(apiKey) ~= "string" or not apiKey:match("^[A-Za-z0-9]+$") or #apiKey < KEY_MIN_LENGTH or #apiKey > KEY_MAX_LENGTH then fail("INVALID_KEY", "key must be alphanumeric and 12-64 characters") end
        if type(raw.Name) ~= "string" or not raw.Name:match("^[A-Za-z0-9]+$") or #raw.Name > NAME_MAX_LENGTH then fail("INVALID_SETTINGS", "Name must be alphanumeric and at most 32 characters") end
        if type(raw.Config) ~= "table" then fail("INVALID_SETTINGS", "Config must be a table") end
        if raw.Debug ~= nil and type(raw.Debug) ~= "boolean" then fail("INVALID_SETTINGS", "Debug must be boolean") end
        settings = {Name = raw.Name, Config = {}}
        local known = {}
        for _, field in ipairs(FIELDS) do
            known[field] = true
            if type(raw.Config[field]) ~= "boolean" then fail("INVALID_SETTINGS", "Config." .. field .. " must be boolean") end
            settings.Config[field] = raw.Config[field]
        end

        if not API_BASE_URL:match("^https://[%w%.%-]+[:%d]*/?[%w%-%._/]*$") or API_BASE_URL:find("YOUR%-TRACKER") then
            fail("API_NOT_CONFIGURED")
        end
        local candidates = {env.request, env.http_request, request, http_request}
        for _, name in ipairs({"syn", "http", "fluxus"}) do
            local value = env[name]
            if type(value) == "table" and type(value.request) == "function" then candidates[#candidates + 1] = value.request end
        end
        for _, fn in pairs(candidates) do
            if type(fn) == "function" then
                requestFn = fn
                break
            end
        end
        if not requestFn then fail("HTTP_UNAVAILABLE") end
        log("SETTINGS_VALID", "Config copied; interval=30s")
    end

    local function api(path, payload)
        local function encode(value, isArray)
            if type(value) ~= "table" then return HttpService:JSONEncode(value) end
            local parts = {}
            if isArray then
                for _, item in ipairs(value) do parts[#parts + 1] = encode(item, false) end
                return "[" .. table.concat(parts, ",") .. "]"
            end
            local names = {}
            for name in pairs(value) do names[#names + 1] = name end
            table.sort(names)
            for _, name in ipairs(names) do
                parts[#parts + 1] = HttpService:JSONEncode(name) .. ":" .. encode(value[name], name == "Items")
            end
            return "{" .. table.concat(parts, ",") .. "}"
        end
        local encoded = encode(payload, false)
        if #encoded > MAX_BYTES then fail("PAYLOAD_TOO_LARGE") end
        local ok, response = xpcall(function()
            return bounded("http", TIMEOUT, function()
                return requestFn({Url = API_BASE_URL:gsub("/$", "") .. path, Method = "POST", Headers = {
                    ["Content-Type"] = "application/json", ["Accept"] = "application/json", ["Authorization"] = "Bearer " .. apiKey,
                }, Body = encoded, Timeout = TIMEOUT, Redirect = false})
            end)
        end, capture)
        if not ok then
            if response.Code == "STOPPED" then error(response, 0) end
            log(response.Code, response.Detail)
            fail("API_SERVER", "HTTP transport unavailable or timed out")
        end
        if type(response) ~= "table" then fail("API_PROTOCOL", "No response table") end
        local status = tonumber(response.StatusCode or response.Status)
        log("HTTP_STATUS", path .. " " .. tostring(status))
        if status == 401 or status == 403 then fail("INVALID_KEY", "Key rejected or revoked") end
        if status == 409 then fail("SESSION_EXPIRED", "Session superseded") end
        if status == 429 or (status and status >= 500) then fail("API_SERVER", "Server unavailable or rate limited") end
        if not status or status < 200 or status >= 300 then fail("API_REJECTED", "Unexpected HTTP status") end
        if type(response.Body) ~= "string" or #response.Body > MAX_BYTES then fail("API_PROTOCOL", "Invalid response body") end
        local decodedOk, body = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if not decodedOk or type(body) ~= "table" or body.ok ~= true then fail("API_PROTOCOL", "Expected JSON ok=true") end
        if path == "/v1/tracker/snapshots" and (body.sessionId ~= sessionId or body.sequence ~= sequence) then
            fail("API_PROTOCOL", "Snapshot acknowledgement mismatch")
        end
        if path == "/v1/tracker/heartbeat" and body.sessionId ~= sessionId then
            fail("API_PROTOCOL", "Heartbeat acknowledgement mismatch")
        end
        return body
    end

    local function remote(name, ...)
        local args = table.pack(...)
        local net = moduleAt("Modules/Net")
        return bounded("remote:" .. name, TIMEOUT, function()
            local target = net:RemoteFunction(name)
            if not target or not target:IsA("RemoteFunction") then fail("REMOTE_MISSING", name) end
            return target:InvokeServer(table.unpack(args, 1, args.n))
        end)
    end

